{
	"name": "proton-vpn-browser-extension",
	"private": true,
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"check": "ts-node test/check.ts",
		"lint": "eslint . && run-p lint:*",
		"lint:css": "stylelint source/**/*.scss",
		"lint-fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"build": "webpack --mode=production",
		"pack": "run-s build zip",
		"build-ff": "webpack --mode=production --config=webpack-ff.config.ts",
		"pack-ff": "run-s build-ff zip-ff",
		"watch": "webpack --mode=development --watch",
		"watch-ff": "webpack --mode=development --watch --config=webpack-ff.config.ts",
		"repack": "node repack.js",
		"crx": "crx3 distribution -o vpn-proton.me.crx",
		"xpi": "web-ext build --overwrite-dest --source-dir=distribution -a . -n vpn-proton.me.xpi",
		"zip": "web-ext build --overwrite-dest --source-dir=distribution -a . -n vpn-proton-chrome.zip && node repack.js vpn-proton-chrome.zip",
		"zip-ff": "web-ext build --overwrite-dest --source-dir=distribution-ff -a . -n vpn-proton-firefox.zip && node repack.js vpn-proton-firefox.zip",
		"zip-source": "node zip-sources.js && node repack.js source.zip",
		"i18n": "ts-node source/js/translation/extract.ts",
		"po": "ts-node source/js/translation/extract.ts po",
		"locales": "ts-node source/js/translation/update-locales.ts",
		"ts": "ts-node",
		"prepare": "husky"
	},
	"devDependencies": {
		"@babel/core": "^8.1.2",
		"@babel/preset-env": "^8.0.7",
		"@eslint/js": "^10.0.1",
		"@types/chrome": "^0.3.7",
		"@types/firefox": "^0.0.34",
		"@types/firefox-webext-browser": "^143.0.1",
		"@types/html": "^1.0.4",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"@vitest/coverage-v8": "^5.1.0",
		"@xhmikosr/decompress": "^11.1.4",
		"archiver": "^8.0.0",
		"babel-loader": "^10.1.1",
		"chrome-webstore-upload-cli": "^4.0.2",
		"clean-webpack-plugin": "^4.0.0",
		"copy-webpack-plugin": "^14.0.0",
		"crx3": "^2.0.0",
		"css-loader": "^7.1.5",
		"css-minimizer-webpack-plugin": "^8.0.0",
		"daily-version": "^2.0.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-prettier": "^5.5.7",
		"glob": "^14.0.6",
		"html": "^1.0.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"lint-staged": "^17.6.0",
		"mini-css-extract-plugin": "^2.10.2",
		"node-html-parser": "^9.0.7",
		"npm-run-all2": "^9.0.4",
		"prettier": "^3.10.1",
		"sass": "^1.108.2",
		"sass-loader": "^17.1.0",
		"stylelint": "^18.0.0",
		"stylelint-config-standard-scss": "^18.0.0",
		"terser-webpack-plugin": "^5.6.1",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "catalog:",
		"typescript-eslint": "^8.72.2",
		"typescript-parser": "^2.6.1",
		"vitest": "^5.1.0",
		"vitest-chrome": "^0.1.0",
		"web-ext": "^10.8.0",
		"webpack": "^5.112.2",
		"webpack-cli": "^7.3.1",
		"whatwg-fetch": "^3.6.20"
	},
	"dependencies": {
		"@sentry/browser": "^11.12.0",
		"plural-forms": "^0.5.5",
		"webext-options-sync": "^4.3.0",
		"webextension-polyfill": "^0.12.0"
	},
	"lint-staged": {
		"*.{js,ts,html}": "eslint"
	}
}
